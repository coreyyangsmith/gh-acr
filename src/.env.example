# =============================================================================
# GH-ACR environment template
# Copy to `src/.env` and fill in values.
# Loaded by `src.startup` (prefers `src/.env`).
# =============================================================================

# --- Default model (used when --model-name is omitted) ---
OPENAI_MODEL=openai/gpt-4o-mini

# --- OpenAI API (scheme: openai/<model>) ---
OPENAI_API_KEY=

# --- Groq API (scheme: groq:<model>) ---
GROQ_API_KEY=

# --- OpenRouter API (scheme: openrouter/<provider>/<model>) ---
# Docs: https://openrouter.ai/docs/quickstart
OPENROUTER_API_KEY=
# Optional override (default: https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=
# Optional attribution headers for OpenRouter rankings
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=

# --- HuggingFace / local cluster (scheme: local:<hf_id>) ---
HF_API_TOKEN=
HUGGINGFACE_HUB_TOKEN=
# LOCAL_MAX_NEW_TOKENS=2048
# LOCAL_TRUNCATION_SIDE=left
# LOCAL_TOKENIZER_BUFFER_TOKENS=512

# --- GitHub (clone / metadata) ---
GITHUB_TOKEN=
GITHUB_REQUEST_INTERVAL=

# --- LangFuse (optional; tracing soft-disabled if keys unset) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENABLED=1

# --- Debug ---
# GHACR_DEBUG=0
