# =============================================================================
# GH-ACR environment template
# Copy to `.env` at the repository root and fill in values.
# Loaded by `src.startup` (prefers root `.env`, then `src/.env`).
# =============================================================================

# --- Default model (used when --model-name is omitted) ---
OPENAI_MODEL=openai/gpt-4o-mini

# --- OpenAI API (scheme: openai/<model>) ---
OPENAI_API_KEY=
# Bounded HTTP timeout for ChatOpenAI (seconds; default 600).
# Falls back to GHACR_LLM_REQUEST_TIMEOUT when unset.
# OPENAI_REQUEST_TIMEOUT=600

# --- Groq API (scheme: groq:<model>) ---
GROQ_API_KEY=
# Bounded HTTP timeout for ChatGroq (seconds; default 120)
# GROQ_REQUEST_TIMEOUT=120

# --- OpenRouter API (scheme: openrouter/<org>/<model>) ---
# Docs: https://openrouter.ai/docs/quickstart
OPENROUTER_API_KEY=
# Bounded HTTP timeout for OpenRouter ChatOpenAI (seconds; default 600).
# Soft-skip alone cannot free hung workers; this timeout unblocks the pool.
# Falls back to GHACR_LLM_REQUEST_TIMEOUT when unset.
# OPENROUTER_REQUEST_TIMEOUT=600
# Shared fallback for OpenAI/OpenRouter request timeouts:
# GHACR_LLM_REQUEST_TIMEOUT=600
# Optional override (default: https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=
# Optional attribution headers for OpenRouter rankings
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=
#
# Optional inference-provider routing (OpenRouter backends), keyed by model family.
# Default when unset: prefer groq with allow_fallbacks=true.
# Explicit OPENROUTER_PROVIDER* values hard-pin (allow_fallbacks defaults false).
# OPENROUTER_PROVIDER_GPT5NANO=openai
# OPENROUTER_PROVIDER_LLAMA3=together
# OPENROUTER_PROVIDER_QWEN3=deepinfra
# OPENROUTER_PROVIDER=together
# OPENROUTER_PROVIDER=off
# OPENROUTER_ALLOW_FALLBACKS=0
# OPENROUTER_ALLOW_FALLBACKS_LLAMA3=0
#
# Quantization filter (default: fp16,bf16,fp32,unknown).
# Blacklists hosts that advertise fp8/int4/etc; keeps unspecified (unknown).
# OPENROUTER_QUANTIZATIONS=fp16,bf16,fp32,unknown
# OPENROUTER_QUANTIZATIONS=off

# --- HuggingFace / local cluster (scheme: local:<hf_id>) ---
HF_API_TOKEN=
HUGGINGFACE_HUB_TOKEN=
# LOCAL_MAX_NEW_TOKENS=2048
# LOCAL_TRUNCATION_SIDE=left
# LOCAL_TOKENIZER_BUFFER_TOKENS=512
# Shared safety buffer subtracted from MODEL_COSTS prompt budget (default 4096).
# Covers OpenRouter/provider token overcounts vs local HF counts; used by
# prompt_budget structured fitting and TruncatingLLMWrapper.
# PROMPT_TRUNCATION_BUFFER=4096

# --- GitHub (clone / metadata) ---
GITHUB_TOKEN=
GITHUB_REQUEST_INTERVAL=

# --- LangFuse (optional; tracing soft-disabled if keys unset) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENABLED=1

# --- Debug / LLM resilience ---
# GHACR_DEBUG=0
# Logging verbosity for console/file (default INFO). Set DEBUG only when needed:
# LOG_LEVEL=INFO
# LOG_LEVEL=DEBUG
# Dump every prompt+response under logs/llm_io/ (off by default)
# GHACR_TRACE_IO=0
# Max retries for transient LLM API failures (default: RL_MAX_RETRIES or 5)
# LLM_MAX_RETRIES=5
# RL_MAX_RETRIES=5
# RL_BACKOFF_INITIAL=0.5
# RL_BACKOFF_MULTIPLIER=2.0
# RL_BACKOFF_MAX=20.0
# RL_BACKOFF_JITTER=0.3

# --- Inference concurrency (scenario worker pool) ---
# Max concurrent scenarios within a batch (default: 8). Override via CLI --concurrency.
# Peak LLM pressure ≈ concurrency × method_concurrency; for ablation runs with many
# methods in parallel, consider lowering --concurrency (e.g. 1–2).
# INFERENCE_CONCURRENCY=8
# Max parallel methods per scenario (CLI --method-concurrency; default min(n_methods, 8)).
# METHOD_CONCURRENCY=4
#
# --- Persistent prep / clones ---
# Clones under GHACR_CLONE_DIR (default ./repos) are kept across batches and model runs.
# GHACR_CLONE_DIR=
# Prepared scenario context (ancestor/parents/diffs/truth) cached here; reused on hit.
# GHACR_CONTEXT_CACHE_DIR=data/context_cache
# BATCH_SIZE still groups scenarios for logging; clones are not deleted after each batch.
# BATCH_SIZE=2
#
# Disable tqdm progress bar (logs still include [progress] ETA lines):
# GHACR_NO_PROGRESS=1
# Client-side RPM/TPM waiting is OFF by default. Set RL_ENABLE_WAITING=1 to pace
# requests locally (legacy soft caps below only apply when waiting is enabled):
# RL_ENABLE_WAITING=0
# RL_DEFAULT_RPM=60
# RL_DEFAULT_TPM=150000
# RL_RPM_GPT4O_MINI=400
# RL_TPM_GPT4O_MINI=180000
# RL_RPM_GPT41_NANO=120
# RL_TPM_GPT41_NANO=300000
#
# Groq llama-3.1-8b-instant (published developer tier: 30 RPM / 6K TPM /
# 14.4K RPD / 500K TPD). Soft defaults are ~90% of published ceilings.
# Enable waiting for concurrent Groq runs:
# RL_ENABLE_WAITING=1
# RL_RPM_GROQ_LLAMA31_8B=27
# RL_TPM_GROQ_LLAMA31_8B=5400
# RL_RPD_GROQ_LLAMA31_8B=14400
# RL_TPD_GROQ_LLAMA31_8B=500000
#
# Stalled-run watchdog (optional; also --watchdog on run_all).
# Default mode=skip soft-skips overdue units, marks ledger timeout failures,
# and cancels cooperative LLM retries so the run continues.
# HTTP request timeouts (OPENROUTER/OPENAI/GHACR_LLM_REQUEST_TIMEOUT, default
# 600s) are required to free ThreadPoolExecutor workers blocked on hung invokes.
# Heartbeat keepalive runs automatically; stale heartbeat alone does not abort.
# Prep/clone is budgeted separately (default 1800s) via --watchdog-max-prep-s.
# GHACR_WATCHDOG=1
# GHACR_WATCHDOG_MODE=skip
# GHACR_WATCHDOG_STALE_S=600
# GHACR_WATCHDOG_MAX_UNIT_S=7200
# GHACR_WATCHDOG_MAX_LLM_S=900
# GHACR_WATCHDOG_MAX_PREP_S=1800
